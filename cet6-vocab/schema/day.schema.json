{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CET-6 Thirty Easy Pieces — one study day",
  "type": "object",
  "required": ["day", "part", "kind", "title", "estimated_minutes", "dialogue", "crux", "scenes", "homework", "summary"],
  "additionalProperties": false,
  "properties": {
    "day": {"type": "integer", "minimum": 1, "maximum": 30},
    "part": {"type": "integer", "minimum": 1, "maximum": 3},
    "kind": {"enum": ["study"]},
    "title": {"type": "string", "minLength": 4, "maxLength": 30},
    "estimated_minutes": {"type": "integer", "minimum": 30, "maximum": 90},
    "story_note": {"type": "string", "maxLength": 300, "description": "写手给审计看的：本集故事线在哪、承接了什么、留了什么钩子"},
    "dialogue": {
      "type": "object", "required": ["title", "turns"], "additionalProperties": false,
      "properties": {
        "title": {"type": "string", "maxLength": 30},
        "turns": {"type": "array", "minItems": 8, "maxItems": 12,
          "items": {"type": "object", "required": ["who", "text"], "additionalProperties": false,
            "properties": {"who": {"enum": ["professor", "student"]}, "text": {"type": "string", "minLength": 2, "maxLength": 160}}}}
      }
    },
    "crux": {
      "type": "object", "required": ["question", "answer"], "additionalProperties": false,
      "properties": {"question": {"type": "string", "maxLength": 40}, "answer": {"type": "string", "maxLength": 120}}
    },
    "scenes": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {
        "type": "object", "required": ["key", "title", "cards"], "additionalProperties": false,
        "properties": {
          "key": {"enum": ["roots", "theme", "freebies", "orphans"]},
          "title": {"type": "string", "maxLength": 40},
          "intro": {"type": "string", "maxLength": 200},
          "cards": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/card"}},
          "boxes": {"type": "array", "items": {"$ref": "#/definitions/box"}}
        }
      }
    },
    "homework": {
      "type": "object", "required": ["exercises"], "additionalProperties": false,
      "properties": {
        "exercises": {"type": "array", "minItems": 1, "maxItems": 3,
          "items": {"type": "object", "required": ["type", "title", "items"], "additionalProperties": false,
            "properties": {
              "type": {"enum": ["parts", "cloze", "match", "translate"]},
              "title": {"type": "string", "maxLength": 40},
              "items": {"type": "array", "minItems": 3, "maxItems": 10,
                "items": {"type": "object", "required": ["prompt", "answer"], "additionalProperties": false,
                  "properties": {"prompt": {"type": "string", "maxLength": 120}, "answer": {"type": "string", "maxLength": 80}, "hint": {"type": "string", "maxLength": 40}}}}
            }}}
      },
      "description": "今日自测与间隔复习由生成器自动产生，写手只写 1–3 个小练习"
    },
    "summary": {"type": "array", "minItems": 3, "maxItems": 5, "items": {"type": "string", "maxLength": 50}}
  },
  "definitions": {
    "card": {
      "type": "object",
      "required": ["id", "head", "family", "ipa", "pos", "senses", "example", "hook", "collocations", "card_style"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "integer", "minimum": 1, "maximum": 1263},
        "head": {"type": "string", "description": "与 data/cet6_star_words.json 逐字一致，含上标"},
        "family": {"type": "array", "items": {"type": "object", "required": ["form", "pos"], "additionalProperties": false,
          "properties": {"form": {"type": "string"}, "pos": {"type": "string", "maxLength": 12}}}},
        "ipa": {"type": "string", "pattern": "^/.+/$"},
        "pos": {"type": "array", "minItems": 1, "items": {"enum": ["n.", "v.", "vt.", "vi.", "adj.", "adv.", "prep.", "conj.", "pron.", "interj.", "num.", "abbr."]}},
        "senses": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "string", "minLength": 1, "maxLength": 40}},
        "example": {"type": "object", "required": ["en", "zh"], "additionalProperties": false,
          "properties": {"en": {"type": "string", "minLength": 20, "maxLength": 200}, "zh": {"type": "string", "minLength": 4, "maxLength": 120}}},
        "hook": {"type": "object", "required": ["type", "text"], "additionalProperties": false,
          "properties": {
            "type": {"enum": ["morph", "story", "pun"]},
            "text": {"type": "string", "minLength": 4, "maxLength": 160},
            "true_etymology": {"type": "boolean", "description": "type=morph 时必填：零件说明是否为真词源"},
            "joke": {"type": "boolean", "description": "这一行是否含一个笑点（用于每页笑点密度统计）"}
          }},
        "collocations": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "string", "maxLength": 60}},
        "card_style": {"enum": ["full", "lite"]},
        "confusable_with": {"type": "array", "items": {"type": "object", "required": ["head", "note"], "additionalProperties": false,
          "properties": {"head": {"type": "string"}, "note": {"type": "string", "maxLength": 80}}}},
        "sense_note": {"type": "string", "maxLength": 100, "description": "同形异义 / 拼写变体 / 英美差异等说明"}
      }
    },
    "box": {
      "type": "object", "required": ["type", "title", "text"], "additionalProperties": false,
      "properties": {
        "type": {"enum": ["aside", "tip"]},
        "title": {"type": "string", "maxLength": 20},
        "text": {"type": "string", "minLength": 20, "maxLength": 260},
        "after_card_id": {"type": "integer", "description": "放在哪张卡片之后；缺省放在场景末尾"},
        "source": {"type": "string", "maxLength": 80, "description": "ASIDE 里的事实出处或「常识」"},
        "joke": {"type": "boolean"}
      }
    }
  }
}
